{
  "schema_version": 1,
  "name": "billing-sla",
  "targets": {"kind": "queue", "ids": ["billing"], "group_ids": []},
  "trigger": {"predicate": {"kind":"compare", "left":{"kind":"field","name":"adherence.violation"}, "op":"gt", "right":{"kind":"field","name":"queue.sla_target"}}, "for":"5m"},
  "clear": {"predicate": {"kind":"compare", "left":{"kind":"field","name":"adherence.violation"}, "op":"lte", "right":{"kind":"field","name":"queue.sla_target"}}, "for":"0s"},
  "notifications": {"on_open":true,"on_recovery":true,"audience":"support-operations"}
}
