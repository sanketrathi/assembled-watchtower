{
  "schema_version": 1,
  "name": "queue-all",
  "targets": {
    "kind": "queue",
    "ids": [
      "billing"
    ],
    "group_ids": []
  },
  "trigger": {
    "predicate": {
      "kind": "all",
      "conditions": [
        {
          "kind": "compare",
          "left": {
            "kind": "field",
            "name": "queue.tickets_waiting"
          },
          "op": "gt",
          "right": {
            "kind": "integer",
            "value": 10
          }
        },
        {
          "kind": "compare",
          "left": {
            "kind": "field",
            "name": "queue.longest_wait"
          },
          "op": "gt",
          "right": {
            "kind": "duration",
            "value": "5m"
          }
        }
      ]
    },
    "for": "1m"
  },
  "clear": {
    "predicate": {
      "kind": "compare",
      "left": {
        "kind": "field",
        "name": "queue.tickets_waiting"
      },
      "op": "lte",
      "right": {
        "kind": "integer",
        "value": 10
      }
    },
    "for": "0s"
  },
  "notifications": {
    "on_open": true,
    "on_recovery": true,
    "audience": "support-operations"
  }
}
